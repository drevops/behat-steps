@startuml
' drevops/behat-steps - data flow for a step running in a consuming project.
' Traced from src/Steps/Web/PathTrait.php, src/Steps/Drupal/ContentTrait.php,
' src/Behat/Context/WebRawContext.php, WebContext.php,
' src/Helper/Drupal/EntityLifecycleTrait.php, src/Helper/Drupal/AuthTrait.php,
' DrupalContext.php, src/Behat/Manager/DriverRegistry.php,
' src/Behat/Listener/SkipTagListener.php,
' src/Behat/Listener/DriverListener.php, src/Driver/DrupalDriver.php, behat.php.
' Regenerate every SVG with:  plantuml -tsvg docs/architecture/*.puml
!theme plain
skinparam backgroundColor white
skinparam defaultFontName Helvetica
skinparam shadowing false
title Data flow: a step runs

participant "Feature file" as Feature
participant "Behat" as Behat
participant "WebContext\nDrupalContext" as Ctx
participant "Step trait method" as Trait
participant "SkipTagListener" as SkipListener
participant "DriverListener" as Listener
participant "DriverRegistry" as DM
participant "Driver\nDrupal, Drush or Blackbox" as Driver
participant "Mink session" as Mink

Behat -> SkipListener: BeforeScenarioTested
activate SkipListener
alt every "@behat-steps-skip:" tag names a trait
  SkipListener --> Behat: continue
else one names a hook or anything else
  SkipListener -> Behat: throw RuntimeException,\nthe run stops before any hook
end
deactivate SkipListener

Behat -> Listener: BeforeScenarioTested
activate Listener
Listener -> Listener: take the configured drivers list,\npromote every "@driver:" tag
Listener -> DM: setScenarioDrivers(order)
deactivate Listener

Behat -> Ctx: instantiate each registered context,\ninject the services via DriverAwareInitializer
activate Ctx
Behat -> Ctx: scan the Given, When and Then step attributes
note right of Behat: attributes inherited\nthrough "use" are\nfound too
Ctx --> Behat: step definitions
deactivate Ctx

Feature -> Behat: Then the path should be "/about-us"
activate Behat
Behat -> Trait: pathAssertCurrent(path)
activate Trait

alt the step only needs the browser
  Trait -> Mink: getSession()->getCurrentUrl()
  activate Mink
  Mink --> Trait: current URL
  deactivate Mink
else the step needs Drupal
  Trait -> DM: driverFor(ContentCapabilityInterface)
  activate DM
  alt a driver in the scenario's order implements it
    DM -> Driver: bootstrap, the first time only
    DM --> Trait: that driver
  else none does
    DM -> Trait: throw UnsupportedDriverActionException
  end
  deactivate DM
  Trait -> Driver: the capability call, e.g. nodeCreate(stub)
  activate Driver
  Driver --> Trait: result
  deactivate Driver
end

alt assertion holds
  Trait --> Behat: void
else it does not
  Trait -> Behat: throw ExpectationException or AssertionException
end
deactivate Trait

Behat --> Feature: step passes or fails
deactivate Behat

Behat -> Ctx: AfterScenario
activate Ctx
Ctx -> Ctx: each hook asks skipTag() for its own trait,\nand returns on the trait's skip tag or enabled = FALSE
Ctx -> Ctx: EntityLifecycleTrait runs entityLifecycleCleanAll,\nAuthTrait authCleanUsers and authCleanRoles
Ctx -> Driver: delete what the scenario created
deactivate Ctx
@enduml
