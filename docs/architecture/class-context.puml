@startuml
' drevops/behat-steps - the context chain, its managers, the helper traits
' and 3 representative step traits, plus the exceptions a failing step throws.
' Traced from src/Behat/Context/WebRawContext.php, WebContext.php,
' DrupalContext.php, DriverAwareInterface.php, DrupalApiInterface.php,
' src/Behat/Manager/, src/Helper/, src/Steps/Web/PathTrait.php,
' src/Steps/Web/CommandTrait.php, src/Steps/Drupal/ContentTrait.php,
' src/Exception/AssertionException.php.
' Regenerate every SVG with:  plantuml -tsvg docs/architecture/*.puml
!theme plain
skinparam backgroundColor white
skinparam defaultFontName Helvetica
skinparam shadowing false
skinparam classAttributeIconSize 0
title Class detail: context, managers, helpers and step traits

package "DrevOps\\BehatSteps\\Behat\\Context" #F3E5F5 {
  class WebRawContext {
    +getDriver(name) : DriverInterface
    +driverFor(capability) : object
    +getRandom() : Random
    +getOption(group, key, scope) : mixed
    --
    #skipTag(name, scope) : bool
    #shouldCleanup() : bool
    #contextConfigDeclarations() : array
    --
    composes the 4 web helper traits
  }

  class WebContext {
    use every Steps\\Web trait
    --
    +assertOneContext(scope) : void
  }

  class DrupalContext {
    use DrupalApiTrait
    use every Steps\\Drupal trait
  }

  interface DrupalApiInterface {
    the public half of DrupalApiTrait
  }

  WebRawContext <|-- WebContext
  WebContext <|-- DrupalContext
  DrupalApiInterface <|.. DrupalContext
}

package "DrevOps\\BehatSteps\\Behat\\Manager" #F3E5F5 {
  interface DriverManagerInterface {
    +getDriverFor(capability) : object
    +hasCapability(capability) : bool
    +setScenarioDrivers(drivers) : void
  }
  interface AuthenticationManagerInterface {
    +logIn(user) : void
    +logOut() : void
    +loggedIn() : bool
  }
  interface UserManagerInterface {
    +getCurrentUser() : EntityStubInterface|false
    +addUser(user) : void
    +currentUserHasRole(role) : bool
  }
  interface MailManagerInterface {
    +startCollectingMail() : void
    +getMail() : array
    +clearMail() : void
  }
}

WebRawContext o--> DriverManagerInterface
WebRawContext o--> AuthenticationManagerInterface
DrupalContext o--> UserManagerInterface

package "DrevOps\\BehatSteps\\Helper" #F3E5F5 {
  class RequestHeadersTrait <<trait>> {
    +setRequestHeader(name, value) : void
    #unsetRequestHeader(name) : void
    #getRequestHeaders() : array
    #resetRequestHeaders() : void
  }
  class StringTrait <<trait>> {
    #fixStepArgument(argument) : string
    #normalizeWhitespace(text) : string
    #splitCommaSeparated(text) : array
    #slug(value) : string
  }
  class LastStepTrait <<trait>> {
    #setLastStepLine(scope) : void
    #isLastStep(scope) : bool
  }
  class JavascriptSupportTrait <<trait>> {
    +isJavascriptSupported() : bool
  }
  class DrupalApiTrait <<trait>> {
    +nodeCreate(stub) : EntityStubInterface
    +userCreate(stub) : EntityStubInterface
    +termCreate(stub) : EntityStubInterface
    +entityCreate(stub) : EntityStubInterface
    +languageCreate(stub) : EntityStubInterface|false
    +entityRegister(entity) : void
    --
    +cleanEntities(scope) : void
    +cleanUsers(scope) : void
    +cleanRoles(scope) : void
    +clearStaticCaches() : void
    --
    +login(user) : void
    +logout(fast) : void
    +loggedIn() : bool
    --
    +loadNodeIds(content_type, conditions) : array
    +assertModuleEnabled(module, package) : void
    +expandEntityFieldsFixtures(entity_type, stub) : void
    +transposeVerticalTable(table) : array
    +buildHorizontalTable(entities) : TableNode
    --
    #dispatchHooks(scopeClass, stub) : void
  }

  RequestHeadersTrait -[hidden]down- StringTrait
  StringTrait -[hidden]down- LastStepTrait
  LastStepTrait -[hidden]down- JavascriptSupportTrait
  JavascriptSupportTrait -[hidden]down- DrupalApiTrait
}

package "Steps\\Web" #E8F5E9 {
  class PathTrait <<trait>> {
    +pathVisit(path) : void
    +pathGoBack() : void
    +pathAssertCurrent(path) : void
    +pathAssertUrlHasParameter(param) : void
  }

  class CommandTrait <<trait>> {
    +commandRun(command) : void
    +commandAssertSuccess() : void
    +commandAssertExitCode(code) : void
    +commandAssertOutputContains(text) : void
  }
}

package "Steps\\Drupal" #E3F2FD {
  class ContentTrait <<trait>>
}

WebRawContext ..> RequestHeadersTrait : composes
WebRawContext ..> StringTrait : composes
WebRawContext ..> LastStepTrait : composes
WebRawContext ..> JavascriptSupportTrait : composes
DrupalContext ..> DrupalApiTrait : composes

PathTrait ..> WebRawContext : requires
ContentTrait ..> WebRawContext : requires
ContentTrait ..> DrupalApiInterface : requires

PathTrait ..> ExpectationException : throws
ContentTrait ..> ExpectationException : throws
CommandTrait ..> AssertionException : throws
CommandTrait ..> RuntimeException : throws

package "Thrown on failure" #FFEBEE {
  class ExpectationException {
    from Behat\\Mink
    --
    +__construct(message, driver)
  }
  class ElementNotFoundException
  class AssertionException {
    DrevOps\\BehatSteps\\Exception
    --
    no driver required
  }
  class UnsupportedDriverActionException {
    no driver in the scenario's
    order provides the capability
  }
  class RuntimeException {
    invalid argument or
    unmet prerequisite
  }
  ExpectationException <|-- ElementNotFoundException
}

note right of CommandTrait
  Never calls getSession(), so it cannot
  pass a driver to ExpectationException.
  It throws AssertionException instead,
  and declares only RawMinkContext.
end note

note bottom of DrupalApiTrait
  Entity, user and role cleanup live here,
  not in a step trait: this trait owns the whole
  Drupal scenario lifecycle and dispatches the
  before/after entity-create hooks.

  A step names a capability through driverFor()
  and never a driver, so the vocabulary carries
  over to a driver a project registers itself.
end note

note bottom of RequestHeadersTrait
  A helper trait composed by a step trait and by
  the context under it holds one property slot,
  so both reach the same state.
end note
@enduml
