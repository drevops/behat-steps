@startuml
' drevops/behat-steps - members of the context, the helpers and 3 representative
' step traits, plus the exceptions a failing step throws.
' Traced from tests/behat/bootstrap/FeatureContext.php, src/HelperTrait.php,
' src/Drupal/HelperTrait.php, src/PathTrait.php, src/CommandTrait.php,
' src/Drupal/ContentTrait.php.
' Regenerate every SVG with:  plantuml -tsvg docs/architecture/*.puml
!theme plain
skinparam backgroundColor white
skinparam defaultFontName Helvetica
skinparam shadowing false
skinparam classAttributeIconSize 0
title Class detail: context, helpers and step traits

class DrupalContext #ECEFF1 {
  from Drupal\\DrupalExtension
  --
  +getSession() : Session
  +getDriver() : DriverInterface
}

class FeatureContext #FFF3E0 {
  written by the consuming project
  --
  use <chosen step traits>
}

DrupalContext <|-- FeatureContext

package "Generic - Mink only" #E8F5E9 {
  class PathTrait <<trait>> {
    +pathAssertCurrent(path) : void
    +pathAssertNotCurrent(path) : bool
    +pathAssertUrlHasParameter(param) : void
    +pathAssertUrlHasParameterWithValue(param, value) : void
    +pathAssertUrlHasNoParameter(param) : void
    +pathSetBasicAuth(username, password) : void
    +pathGoBack() : void
  }

  class HelperTrait <<trait>> #F3E5F5 {
    #helperSetLastStepLine(scope) : void
    #helperIsLastStep(scope) : bool
    #helperTransposeVerticalTable(table) : array
    #helperBuildHorizontalTable(entities) : TableNode
    #helperFixStepArgument(argument) : string
    #helperNormalizeWhitespace(text) : string
    #helperSplitCommaSeparated(text) : array
    #helperSlug(value) : string
    #helperIsJavascriptSupported() : bool
  }
}

package "Generic - no Mink session" #E8F5E9 {
  class CommandTrait <<trait>> {
    +commandBeforeScenario() : void
    +commandAfterScenario() : void
    +commandRun(command) : void
    +commandAssertSuccess() : void
    +commandAssertFailure() : void
    +commandAssertExitCode(code) : void
    +commandAssertOutputContains(text) : void
    +commandAssertDurationLessThan(seconds) : void
    --
    #commandResetState() : void
    #commandTimeout() : int
  }
}

package "Drupal" #E3F2FD {
  class ContentTrait <<trait>> {
    +contentRemoveContentType(content_type) : void
    +contentDelete(content_type, table) : void
    +contentCreateWithFields(type, table) : void
    +contentVisitViewWithTitle(content_type, title) : void
    +contentChangeModerationStateWithTitle(content_type, title, new_state) : void
    +contentSetPathAliasWithTitle(content_type, title, alias) : void
    +contentAssertPublishedWithTitle(content_type, title) : void
    +contentBeforeNodeCreate(scope) : void
  }

  class DrupalHelperTrait <<trait>> #F3E5F5 {
    #entityRegistry : array
    --
    #entityRegister(entity) : void
    #entityRegisterId(entity_type_id, entity_id) : void
    +entityCleanupAfterScenario(scope) : void
    #entityCleanupRun(skip_types) : void
    #entityCleanupDelete(entity_type_id, entity_id) : void
    #entityCleanupSkippedTypes(tags) : array
    #helperResolveFixtureFile(value, fixture_path) : ?string
    #helperAssertModuleEnabled(module, package) : void
  }
}

package "Thrown on failure" #FFEBEE {
  class ExpectationException {
    from Behat\\Mink
    --
    +__construct(message, driver)
  }
  class ElementNotFoundException
  class UnsupportedDriverActionException
  class RuntimeException {
    invalid argument or
    unmet prerequisite
  }
  ExpectationException <|-- ElementNotFoundException
}

FeatureContext ..> PathTrait : use
FeatureContext ..> CommandTrait : use
FeatureContext ..> ContentTrait : use

PathTrait ..> HelperTrait
ContentTrait ..> DrupalHelperTrait

PathTrait ..> ExpectationException : throws
ContentTrait ..> ExpectationException : throws
ContentTrait ..> RuntimeException : throws
CommandTrait ..> RuntimeException : throws

note right of CommandTrait
  Never calls getSession(), so it
  cannot pass a driver to
  ExpectationException.
end note

note bottom of DrupalHelperTrait
  entityCleanupAfterScenario carries the
  AfterScenario('@api') hook attribute and
  deletes the registry in reverse creation
  order.
end note
@enduml
