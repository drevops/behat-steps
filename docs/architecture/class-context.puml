@startuml
' drevops/behat-steps - the context chain, its services, the helper traits
' and 3 representative step traits, plus the exceptions a failing step throws.
' Traced from src/Behat/Context/WebRawContext.php, WebContext.php,
' DrupalContext.php, DriverAwareInterface.php, UserAwareInterface.php,
' src/Behat/Manager/, src/Helper/Web/, src/Helper/Drupal/,
' src/Steps/Web/PathTrait.php, src/Steps/Web/CommandTrait.php,
' src/Steps/Drupal/ContentTrait.php, src/Exception/AssertionException.php.
' Regenerate every SVG with:  plantuml -tsvg docs/architecture/*.puml
!theme plain
skinparam backgroundColor white
skinparam defaultFontName Helvetica
skinparam shadowing false
skinparam classAttributeIconSize 0
title Class detail: context, services, helpers and step traits

package "DrevOps\\BehatSteps\\Behat\\Context" #F3E5F5 {
  class WebRawContext {
    +getDriver(name) : DriverInterface
    +driverFor(capability) : object
    +getRandom() : Random
    +getOption(group, key, scope) : mixed
    +getBasicAuthenticator() : BasicAuthenticatorInterface
    --
    #skipTag(name, scope) : bool
    #shouldCleanup() : bool
    #contextConfigDeclarations() : array
    --
    composes the 4 web helper traits
  }

  class WebContext {
    use every Steps\\Web trait
    --
    +assertOneContext(scope) : void
  }

  class DrupalContext {
    use every Steps\\Drupal trait
  }

  interface UserAwareInterface {
    +authSetUserRegistry(registry) : void
    +authGetUserRegistry() : UserRegistryInterface
    +authSetAuthenticator(authenticator) : void
    +authGetAuthenticator() : AuthenticatorInterface
  }

  WebRawContext <|-- WebContext
  WebContext <|-- DrupalContext
  UserAwareInterface <|.. DrupalContext
}

package "DrevOps\\BehatSteps\\Behat\\Manager" #F3E5F5 {
  interface DriverRegistryInterface {
    +getDriverFor(capability) : object
    +hasCapability(capability) : bool
    +setScenarioDrivers(drivers) : void
  }
  interface BasicAuthenticatorInterface {
    +applyBasicAuth() : void
  }
  interface AuthenticatorInterface {
    +logIn(user) : void
    +logOut() : void
    +loggedIn() : bool
  }
  interface UserRegistryInterface {
    +getCurrentUser() : EntityStubInterface|false
    +addUser(user) : void
    +currentUserHasRole(role) : bool
  }
}

WebRawContext o--> DriverRegistryInterface
WebRawContext o--> BasicAuthenticatorInterface
AuthTrait o--> UserRegistryInterface
AuthTrait o--> AuthenticatorInterface

package "DrevOps\\BehatSteps\\Helper\\Web" #F3E5F5 {
  class RequestHeadersTrait <<trait>> {
    +requestHeadersSet(name, value) : void
    #requestHeadersUnset(name) : void
    #requestHeadersAll() : array
    #requestHeadersReset() : void
  }
  class StringTrait <<trait>> {
    #stringFixStepArgument(argument) : string
    #stringNormalizeWhitespace(text) : string
    #stringSplitCommaSeparated(text) : array
    #stringSlug(value) : string
  }
  class LastStepTrait <<trait>> {
    #lastStepSetLine(scope) : void
    #lastStepReached(scope) : bool
  }
  class JavascriptSupportTrait <<trait>> {
    +javascriptSupportAvailable() : bool
  }
  class TableTransposeTrait <<trait>> {
    +tableTransposeVertical(table) : array
    +tableTransposeHorizontal(entities) : TableNode
  }

  RequestHeadersTrait -[hidden]down- StringTrait
  StringTrait -[hidden]down- LastStepTrait
  LastStepTrait -[hidden]down- JavascriptSupportTrait
  JavascriptSupportTrait -[hidden]down- TableTransposeTrait
}

package "DrevOps\\BehatSteps\\Helper\\Drupal" #F3E5F5 {
  class EntityLifecycleTrait <<trait>> {
    +entityLifecycleNodeCreate(stub) : EntityStubInterface
    +entityLifecycleTermCreate(stub) : EntityStubInterface
    +entityLifecycleCreate(stub) : EntityStubInterface
    +entityLifecycleLanguageCreate(stub) : EntityStubInterface|false
    +entityLifecycleRegister(entity) : void
    --
    +entityLifecycleCleanAll(scope) : void
    --
    #entityLifecycleDispatchHooks(scopeClass, stub) : void
  }

  class AuthTrait <<trait>> {
    +authUserCreate(stub) : EntityStubInterface
    +authLogin(user) : void
    +authLogout(fast) : void
    +authLoggedIn() : bool
    --
    +authCleanUsers(scope) : void
    +authCleanRoles(scope) : void
  }

  class StaticCacheTrait <<trait>> {
    +staticCacheClear() : void
  }

  class FixtureFileTrait <<trait>> {
    +fixtureFileExpandEntityFields(entity_type, stub) : void
  }

  class QueryTrait <<trait>> {
    +queryNodeIds(content_type, conditions) : array
    +queryAssertModuleEnabled(module, package) : void
  }

  EntityLifecycleTrait -[hidden]down- AuthTrait
  AuthTrait -[hidden]down- StaticCacheTrait
  StaticCacheTrait -[hidden]down- FixtureFileTrait
  FixtureFileTrait -[hidden]down- QueryTrait
}

package "Steps\\Web" #E8F5E9 {
  class PathTrait <<trait>> {
    +pathVisit(path) : void
    +pathGoBack() : void
    +pathAssertCurrent(path) : void
    +pathAssertUrlHasParameter(param) : void
  }

  class CommandTrait <<trait>> {
    +commandRun(command) : void
    +commandAssertSuccess() : void
    +commandAssertExitCode(code) : void
    +commandAssertOutputContains(text) : void
  }
}

package "Steps\\Drupal" #E3F2FD {
  class ContentTrait <<trait>>
}

WebRawContext ..> RequestHeadersTrait : composes
WebRawContext ..> StringTrait : composes
WebRawContext ..> LastStepTrait : composes
WebRawContext ..> JavascriptSupportTrait : composes
AuthTrait ..> EntityLifecycleTrait : composes

PathTrait ..> WebRawContext : requires
ContentTrait ..> WebRawContext : requires
ContentTrait ..> EntityLifecycleTrait : composes
ContentTrait ..> QueryTrait : composes
ContentTrait ..> FixtureFileTrait : composes
ContentTrait ..> TableTransposeTrait : composes

PathTrait ..> ExpectationException : throws
ContentTrait ..> ExpectationException : throws
CommandTrait ..> AssertionException : throws
CommandTrait ..> RuntimeException : throws

package "Thrown on failure" #FFEBEE {
  class ExpectationException {
    from Behat\\Mink
    --
    +__construct(message, driver)
  }
  class ElementNotFoundException
  class AssertionException {
    DrevOps\\BehatSteps\\Exception
    --
    no driver required
  }
  class UnsupportedDriverActionException {
    no driver in the scenario's
    order provides the capability
  }
  class RuntimeException {
    invalid argument or
    unmet prerequisite
  }
  ExpectationException <|-- ElementNotFoundException
}

note right of CommandTrait
  Never calls getSession(), so it cannot
  pass a driver to ExpectationException.
  It throws AssertionException instead,
  and declares only RawMinkContext.
end note

note bottom of EntityLifecycleTrait
  Entity cleanup lives with the concern that
  creates entities. Every step trait that creates
  one composes this, and trait flattening is
  idempotent, so there is still one registry and
  one reverse-order deletion pass.

  A step names a capability through driverFor()
  and never a driver, so the vocabulary carries
  over to a driver a project registers itself.
end note

note bottom of RequestHeadersTrait
  A helper trait composed by a step trait and by
  the context under it holds one property slot,
  so both reach the same state.
end note

note right of BasicAuthenticatorInterface
  Applying credentials to a request needs Mink and
  a base URL, so BasicAuthenticator is separate from
  the Drupal session services and WebRawContext
  carries only this one.
end note
@enduml
