@startuml
' drevops/behat-steps - layered component architecture.
' Traced from composer.json, src/WebRawContext.php, src/WebContext.php,
' src/DrupalContext.php, src/Steps/, src/Steps/Helper/, src/Extension/,
' src/Extension/Drupal/, src/Backend/, src/Backend/Drupal/, behat.php,
' scripts/lint-layers.php.
' Regenerate every SVG with:  plantuml -tsvg docs/architecture/*.puml
!theme plain
skinparam backgroundColor white
skinparam defaultFontName Helvetica
skinparam shadowing false
skinparam componentStyle rectangle
title Component architecture

package "Consuming project" #FFF3E0 {
  component "Feature files\n~*.feature" as Features
  component "behat.php\nextension settings,\nregisters one context" as Config
  component "Own context\nextends WebRawContext,\ncomposes the chosen traits" as Consumer
}

package "drevops/behat-steps" {

  package "Contexts - the package root" #E3F2FD {
    component "WebRawContext\nbackend and browser access,\noption reads, HTTP clients,\nprerequisite checks,\nhook dispatch, no steps" as WebRawCtx
    component "WebContext\nDrupalContext\none chain, whole vocabulary" as Vocabularies
  }

  package "Vocabulary - src/Steps" #E3F2FD {
    component "Steps\\Web\n28 traits, Mink only" as WebSteps
    component "Steps\\Drupal\n29 traits, Drupal sites only,\nmost through a backend" as DrupalSteps
    component "Steps\\Helper\\Web\n8 traits: last step,\nrequest headers, strings,\ntable transpose, tokens,\nfixture directory, headings,\nJavaScript errors" as WebHelpers
    component "Steps\\Helper\\Drupal\n5 traits: entity lifecycle,\nauthentication, static cache,\nfixture files, queries" as DrupalHelpers
  }

  package "Extension - src/Extension" #F3E5F5 {
    component "BehatStepsExtension\nservice wiring, loads the\nshipped backend providers" as Ext
    component "Registries\nsrc/Extension/Registry: backend,\nuser, scenario tags" as Registries
    component "Authenticators\nsrc/Extension/Auth: user login,\nHTTP Basic credentials" as Authenticators
    component "Listeners\nbackend order and scenario tags,\nskip tags that name no trait\nthe suite composes" as Listeners
    component "Config\nschema reader, option resolver,\ntag overrides, parameter reads" as OptionConfig
    component "BrowserKitFactory\nbuilds every browserkit_http\nsession as Mink does,\nrecords its options" as BrowserKit
    component "Browser capabilities\nsrc/Extension/Browser: resolver,\n5 capabilities, 3 adapters" as BrowserCaps
    component "HTTP clients\nsrc/Extension/Http: factory, identity,\nthe shared transport" as HttpClients
    component "Prerequisite\ntrait declarations stated\nthrough capabilities, reader" as Prereq
    component "Hooks\nsrc/Extension/Hook: entity and\nuser creation hooks, each\nattribute names its call" as Hooks

    package "Extension\\Drupal" #F3E5F5 {
      component "DrupalBackendProvider\ndrupal: and drush: settings,\nlogin defaults, the 2 backends'\nservice definitions, Core wiring" as DrupalProvider
      component "Drupal hooks\nnode, term and language\ncreation hooks" as DrupalHooks
    }
  }

  package "Backend - src/Backend" #E8F5E9 {
    component "BackendInterface\n+ 10 capability interfaces\nany backend may provide,\nRandomGenerator" as BackendIface
    component "BlackboxBackend\nno backend access at all" as BlackboxBe

    package "Backend\\Drupal" #E8F5E9 {
      component "17 Drupal-only capabilities\nBatch, Block, Config, Core, Draggableviews,\nDrush, File, Log, Module, Node, Queue,\nQueueItem, SearchApi, SearchIndex, State,\nTerm, Workflow" as DrupalCaps
      component "DrupalBackend\nbootstraps Drupal in-process" as DrupalBe
      component "DrushBackend\nshells out to drush" as DrushBe
      component "Core\nfield handlers, classifiers,\nparsers, creation aliases" as Core
    }
  }
}

package "Runtime and targets" #ECEFF1 {
  component "Behat\nstep matching and hooks" as Behat
  component "Mink extension\nMink's own,\nunder the mink key" as MinkExt
  component "Mink session" as Mink
  component "Browser\nBrowserKit, Selenium2,\nChrome DevTools" as Browser
  component "Drupal site\nentity API, config, drush" as Site
}

Features --> Behat : steps
Config --> Ext : configures
Config --> MinkExt : configures
Config --> Vocabularies : registers
Behat --> Consumer : matches and invokes
Behat --> Vocabularies : matches and invokes

WebSteps --> Vocabularies : composed by
DrupalSteps --> Vocabularies : composed by
WebSteps --> Consumer : mixed into
DrupalSteps --> Consumer : mixed into
WebSteps ..> WebHelpers : composes
DrupalSteps ..> WebHelpers : composes
DrupalSteps ..> DrupalHelpers : composes
WebRawCtx ..> WebHelpers : composes
Consumer ..> WebHelpers : composes
Consumer ..> DrupalHelpers : composes
DrupalSteps ..> DrupalHooks : declares
DrupalHelpers ..> Hooks : dispatches
DrupalHelpers ..> DrupalHooks : dispatches

Consumer --|> WebRawCtx
Vocabularies --|> WebRawCtx
Ext --> Registries : registers
Ext --> Authenticators : registers
Ext --> Listeners : registers
Ext --> OptionConfig : registers
Ext --> BlackboxBe : registers
Ext --> DrupalProvider : loads
Behat --> Listeners : before each scenario
Listeners --> Registries : backend order,\nscenario tags
DrupalProvider --> DrupalBe : defines,\nwires Core into
DrupalProvider --> DrushBe : defines
Ext ..> BrowserKit : registers with Mink,\nreads the session options
Ext --> HttpClients : defines the shared transport\nfrom the session options
Ext ..> Mink : aliases DocumentElement
WebRawCtx --> Registries : backendFor()
WebRawCtx --> Authenticators : basic auth
WebRawCtx --> OptionConfig : resolves trait options
WebRawCtx --> BrowserCaps : browserDriverFor()
WebRawCtx --> HttpClients : detached and\nbare clients
WebRawCtx --> Hooks : dispatches through\nBehat's hook dispatcher
OptionConfig --> Registries : reads the scenario's tags
WebRawCtx --> Prereq : reads trait prerequisites
OptionConfig -[hidden]down- Prereq

Authenticators --> Registries : current user,\nbackend session
Authenticators --> BrowserCaps : whether the session\nruns JavaScript
Authenticators ..> OptionConfig : login text and\nselectors
Authenticators --> Mink : log in through\nthe session
Registries --> BackendIface : resolves by capability
Registries --> DrupalCaps : resolves by capability
DrupalBe ..|> BackendIface
DrupalBe ..|> DrupalCaps
DrushBe ..|> BackendIface
DrushBe ..|> DrupalCaps
BlackboxBe ..|> BackendIface
DrupalBe --> Core

MinkExt --> Mink : builds sessions,\npicks one per scenario
MinkExt ..> BrowserKit : builds the browserkit_http\nbrowser driver with
Consumer --> Mink
Mink --> Browser
BrowserCaps --> Mink : adapts the session's\nbrowser driver
Browser --> Site : page requests
HttpClients --> Site : requests steps\nsend from PHP
DrupalBe --> Site
DrushBe --> Site

note bottom of BackendIface
  The backend layer references nothing from Behat, Mink or the
  layers above it, so it is usable without Behat loaded. The root
  of each of the 2 lower layers, outside its Drupal sub-namespace,
  references no Drupal class, and neither does the web half of
  the vocabulary.
  scripts/lint-layers.php fails the build on any of them.
end note

Features -[hidden]down- Config
WebSteps -[hidden]right- DrupalSteps
Ext -[hidden]down- BrowserKit
BrowserKit -[hidden]down- HttpClients
OptionConfig -[hidden]down- BrowserCaps
DrupalBe -[hidden]right- DrushBe
@enduml
