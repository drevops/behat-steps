@startuml
' drevops/behat-steps - layered component architecture.
' Traced from composer.json, src/Steps/, src/Helper/, src/Behat/, src/Driver/,
' behat.php, scripts/lint-layers.php.
' Regenerate every SVG with:  plantuml -tsvg docs/architecture/*.puml
!theme plain
skinparam backgroundColor white
skinparam defaultFontName Helvetica
skinparam shadowing false
skinparam componentStyle rectangle
title Component architecture

package "Consuming project" #FFF3E0 {
  component "Feature files\n*.feature" as Features
  component "behat.php\nextension settings,\nregisters one context" as Config
  component "Own context\nextends WebRawContext,\ncomposes the chosen traits" as Consumer
}

package "drevops/behat-steps" {

  package "Vocabulary - src/Steps" #E3F2FD {
    component "Steps\\Web\n28 traits, Mink only" as WebSteps
    component "Steps\\Drupal\n29 traits, need the driver" as DrupalSteps
  }

  package "Helpers - src/Helper" #F3E5F5 {
    component "5 concern traits\nlast step, request headers,\nstrings, JavaScript support,\nDrupalApiTrait: entity creation,\ncleanup, login, hooks" as Helpers
  }

  package "Integration - src/Behat" #F3E5F5 {
    component "BehatStepsExtension\nservice wiring" as Ext
    component "WebRawContext\ndriver access, configuration,\nhook dispatch, no steps" as WebRawCtx
    component "WebContext\nDrupalContext\none chain, whole vocabulary" as Vocabularies
    component "Managers\nDriver, Authentication,\nUser, Mail" as Managers
    component "MinkExtension\nwraps Mink's extension,\nadds browserkit_http" as MinkExt
  }

  package "Driver - src/Driver" #E8F5E9 {
    component "DriverInterface\n+ 16 capability interfaces" as DriverIface
    component "DrupalDriver\nbootstraps Drupal in-process" as DrupalDrv
    component "DrushDriver\nshells out to drush" as DrushDrv
    component "BlackboxDriver\nno Drupal at all" as BlackboxDrv
    component "Core\nfield handlers, classifiers,\nparsers, creation aliases" as Core
  }
}

package "Runtime and targets" #ECEFF1 {
  component "Behat\nstep matching and hooks" as Behat
  component "Mink session" as Mink
  component "Browser\nBrowserKit, Selenium2,\nChrome DevTools" as Browser
  component "Drupal site\nentity API, config, drush" as Site
}

Features --> Behat : steps
Config --> Ext : configures
Config --> MinkExt : configures
Config --> Vocabularies : registers
Behat --> Consumer : matches and invokes
Behat --> Vocabularies : matches and invokes

WebSteps --> Vocabularies : composed by
DrupalSteps --> Vocabularies : composed by
WebSteps --> Consumer : mixed into
DrupalSteps --> Consumer : mixed into
WebSteps ..> Helpers : composes
DrupalSteps ..> Helpers : composes
WebRawCtx ..> Helpers : composes
Vocabularies ..> Helpers : composes
Consumer ..> Helpers : composes

Consumer --|> WebRawCtx
Vocabularies --|> WebRawCtx
Ext --> Managers : registers
Ext --> DriverIface : registers drivers
Ext ..> MinkExt : reads ajax_timeout
Ext ..> Mink : aliases DocumentElement
WebRawCtx --> Managers

Managers --> DriverIface : resolves by capability
DrupalDrv ..|> DriverIface
DrushDrv ..|> DriverIface
BlackboxDrv ..|> DriverIface
DrupalDrv --> Core

MinkExt --> Mink : builds sessions,\npicks one per scenario
Consumer --> Mink
Mink --> Browser
DrupalDrv --> Site
DrushDrv --> Site

note bottom of DriverIface
  The driver layer references nothing from Behat or Mink,
  so it is usable without Behat loaded. The web half
  references no Drupal class beyond the random generator.
  scripts/lint-layers.php fails the build on either reference.
end note

Features -[hidden]down- Config
WebSteps -[hidden]right- DrupalSteps
DrupalDrv -[hidden]right- DrushDrv
DrushDrv -[hidden]right- BlackboxDrv
@enduml
