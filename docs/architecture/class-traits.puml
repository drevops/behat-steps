@startuml
' drevops/behat-steps - the step vocabulary and the contexts it mixes into.
' Traced from src/Steps/Web/, src/Steps/Drupal/, src/Helper/,
' src/Behat/Context/RawContext.php, WebRawContext.php, DrupalRawContext.php,
' WebContext.php, DrupalContext.php, DriverAwareInterface.php,
' UserAwareInterface.php, tests/behat/bootstrap/FeatureContext.php.
' Regenerate every SVG with:  plantuml -tsvg docs/architecture/*.puml
!theme plain
skinparam backgroundColor white
skinparam defaultFontName Helvetica
skinparam shadowing false
skinparam classAttributeIconSize 0
skinparam nodesep 12
skinparam ranksep 20
title Class structure: step traits

package "Behat\\MinkExtension\\Context" #ECEFF1 {
  abstract class RawMinkContext {
    +getSession() : Session
    +getMinkParameter(name) : mixed
  }
}

package "DrevOps\\BehatSteps\\Behat\\Context" #F3E5F5 {
  interface DriverAwareInterface
  interface UserAwareInterface
  class RawContext {
    driver access, configuration
  }
  class WebRawContext {
    web plumbing, no steps
  }
  class DrupalRawContext {
    Drupal lifecycle, no steps
  }
  class WebContext {
    use every Steps\\Web trait
  }
  class DrupalContext {
    use every Steps\\Drupal trait
  }
}

class "Own context" as Consumer #FFF3E0 {
  written by the consuming project
  --
  use <any of the traits below>
}

RawMinkContext <|-- RawContext
DriverAwareInterface <|.. RawContext
UserAwareInterface <|.. DrupalRawContext
RawContext <|-- WebRawContext
RawContext <|-- DrupalRawContext
WebRawContext <|-- WebContext
DrupalRawContext <|-- DrupalContext
WebRawContext <|-- Consumer

