@startuml
' drevops/behat-steps - the full trait inventory and the type it mixes into.
' Traced from src/*.php, src/Drupal/*.php,
' tests/behat/bootstrap/FeatureContext.php.
' Regenerate every SVG with:  plantuml -tsvg docs/architecture/*.puml
!theme plain
skinparam backgroundColor white
skinparam defaultFontName Helvetica
skinparam shadowing false
skinparam classAttributeIconSize 0
skinparam nodesep 12
skinparam ranksep 20
title Class structure: step traits

package "Behat\\MinkExtension\\Context" #ECEFF1 {
  abstract class RawMinkContext {
    +getSession() : Session
    +getMinkParameter(name) : mixed
  }
}

package "Drupal\\DrupalExtension\\Context" #ECEFF1 {
  abstract class RawDrupalContext
  class DrupalContext
}

class FeatureContext #FFF3E0 {
  written by the consuming project
  --
  use <any of the traits below>
}

RawMinkContext <|-- RawDrupalContext
RawDrupalContext <|-- DrupalContext
DrupalContext <|-- FeatureContext

package "DrevOps\\BehatSteps - generic, Mink only" #E8F5E9 {
  class HelperTrait <<trait>> #F3E5F5

  class AccessibilityTrait <<trait>>
  class CommandTrait <<trait>>
  class CookieTrait <<trait>>
  class DateTrait <<trait>>
  class DiagnosticsTrait <<trait>>
  class DropzoneTrait <<trait>>

  class ElementTrait <<trait>>
  class FieldTrait <<trait>>
  class FileDownloadTrait <<trait>>
  class IframeTrait <<trait>>
  class JavascriptTrait <<trait>>
  class JsonTrait <<trait>>

  class KeyboardTrait <<trait>>
  class LinkTrait <<trait>>
  class MetatagTrait <<trait>>
  class ModalTrait <<trait>>
  class PathTrait <<trait>>
  class ResponseTrait <<trait>>

  class ResponsiveTrait <<trait>>
  class RestTrait <<trait>>
  class TableTrait <<trait>>
  class WaitTrait <<trait>>
  class XmlTrait <<trait>>

  AccessibilityTrait -[hidden]down- CommandTrait
  CommandTrait -[hidden]down- CookieTrait
  CookieTrait -[hidden]down- DateTrait
  DateTrait -[hidden]down- DiagnosticsTrait
  DiagnosticsTrait -[hidden]down- DropzoneTrait

  ElementTrait -[hidden]down- FieldTrait
  FieldTrait -[hidden]down- FileDownloadTrait
  FileDownloadTrait -[hidden]down- IframeTrait
  IframeTrait -[hidden]down- JavascriptTrait
  JavascriptTrait -[hidden]down- JsonTrait

  KeyboardTrait -[hidden]down- LinkTrait
  LinkTrait -[hidden]down- MetatagTrait
  MetatagTrait -[hidden]down- ModalTrait
  ModalTrait -[hidden]down- PathTrait
  PathTrait -[hidden]down- ResponseTrait

  ResponsiveTrait -[hidden]down- RestTrait
  RestTrait -[hidden]down- TableTrait
  TableTrait -[hidden]down- WaitTrait
  WaitTrait -[hidden]down- XmlTrait
  XmlTrait -[hidden]down- HelperTrait
}

package "DrevOps\\BehatSteps\\Drupal" #E3F2FD {
  class DrupalHelperTrait <<trait>> #F3E5F5

  class BigPipeTrait <<trait>>
  class BlockTrait <<trait>>
  class CacheTrait <<trait>>
  class ConfigOverrideTrait <<trait>>
  class ConfigTrait <<trait>>
  class ContentBlockTrait <<trait>>
  class ContentTrait <<trait>>

  class DraggableviewsTrait <<trait>>
  class EckTrait <<trait>>
  class EmailTrait <<trait>>
  class FileTrait <<trait>>
  class MediaTrait <<trait>>
  class MenuTrait <<trait>>
  class ModuleTrait <<trait>>

  class OverrideTrait <<trait>>
  class ParagraphsTrait <<trait>>
  class QueueTrait <<trait>>
  class RedirectTrait <<trait>>
  class SearchApiTrait <<trait>>
  class StateTrait <<trait>>
  class TaxonomyTrait <<trait>>

  class TestmodeTrait <<trait>>
  class TimeTrait <<trait>>
  class UserTrait <<trait>>
  class WatchdogTrait <<trait>>
  class WebformTrait <<trait>>

  BigPipeTrait -[hidden]down- BlockTrait
  BlockTrait -[hidden]down- CacheTrait
  CacheTrait -[hidden]down- ConfigOverrideTrait
  ConfigOverrideTrait -[hidden]down- ConfigTrait
  ConfigTrait -[hidden]down- ContentBlockTrait
  ContentBlockTrait -[hidden]down- ContentTrait

  DraggableviewsTrait -[hidden]down- EckTrait
  EckTrait -[hidden]down- EmailTrait
  EmailTrait -[hidden]down- FileTrait
  FileTrait -[hidden]down- MediaTrait
  MediaTrait -[hidden]down- MenuTrait
  MenuTrait -[hidden]down- ModuleTrait

  OverrideTrait -[hidden]down- ParagraphsTrait
  ParagraphsTrait -[hidden]down- QueueTrait
  QueueTrait -[hidden]down- RedirectTrait
  RedirectTrait -[hidden]down- SearchApiTrait
  SearchApiTrait -[hidden]down- StateTrait
  StateTrait -[hidden]down- TaxonomyTrait

  TestmodeTrait -[hidden]down- TimeTrait
  TimeTrait -[hidden]down- UserTrait
  UserTrait -[hidden]down- WatchdogTrait
  WatchdogTrait -[hidden]down- WebformTrait
  WebformTrait -[hidden]down- DrupalHelperTrait
}

note bottom of FeatureContext
  A consuming project mixes in only the traits it needs.
  The project's own test FeatureContext composes every
  one of them, and that is the class docs.php reflects
  over to build STEPS.md.

  Both HelperTrait classes carry shared logic and no
  steps. Which step traits use which helper is drawn in
  the class-detail diagram.
end note
@enduml
