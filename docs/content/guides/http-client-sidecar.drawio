<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="drawio" version="26.0.0">
  <diagram id="http-client-sidecar" name="HTTP client sidecar">
    <mxGraphModel dx="0" dy="0" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1540" pageHeight="700" background="#ffffff" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="Behat Steps: the sidecar client" style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=middle;spacing=0;fontFamily=Helvetica;strokeColor=none;fillColor=none;fontSize=22;fontStyle=1;fontColor=#263238;" vertex="1" parent="1">
          <mxGeometry x="16" y="16" width="900" height="34" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="In a @javascript scenario the browser makes the page's requests, and a few steps still send their own from PHP." style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=middle;spacing=0;fontFamily=Helvetica;strokeColor=none;fillColor=none;fontSize=13;fontColor=#546E7A;" vertex="1" parent="1">
          <mxGeometry x="16" y="54" width="1300" height="22" as="geometry" />
        </mxCell>
        <mxCell id="grp-scenario" value="A @javascript scenario" style="swimlane;startSize=30;rounded=1;arcSize=6;html=1;whiteSpace=wrap;collapsible=0;fontFamily=Helvetica;fontSize=15;fontStyle=1;fontColor=#263238;align=left;spacingLeft=10;strokeWidth=1.5;fillColor=#E3F2FD;swimlaneFillColor=#E3F2FD;strokeColor=#1565C0;" vertex="1" parent="1">
          <mxGeometry x="40" y="110" width="1000" height="330" as="geometry" />
        </mxCell>
        <mxCell id="a-steps" value="&lt;b&gt;Visits, clicks, AJAX&lt;/b&gt;&lt;br&gt;the steps that work through the page" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;strokeWidth=1.5;fontFamily=Helvetica;fontSize=13;fontColor=#263238;spacing=8;fillColor=#ffffff;strokeColor=#1565C0;" vertex="1" parent="grp-scenario">
          <mxGeometry x="30" y="60" width="300" height="90" as="geometry" />
        </mxCell>
        <mxCell id="browser" value="&lt;b&gt;The browser&lt;/b&gt;&lt;br&gt;configured by its capabilities,&lt;br&gt;such as acceptInsecureCerts" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;strokeWidth=1.5;fontFamily=Helvetica;fontSize=13;fontColor=#263238;spacing=8;fillColor=#ffffff;strokeColor=#546E7A;dashed=1;" vertex="1" parent="grp-scenario">
          <mxGeometry x="650" y="60" width="320" height="90" as="geometry" />
        </mxCell>
        <mxCell id="b-steps" value="&lt;b&gt;A file download, the hreflang check&lt;/b&gt;&lt;br&gt;steps that send a request of their own" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;strokeWidth=1.5;fontFamily=Helvetica;fontSize=13;fontColor=#263238;spacing=8;fillColor=#ffffff;strokeColor=#1565C0;" vertex="1" parent="grp-scenario">
          <mxGeometry x="30" y="210" width="300" height="90" as="geometry" />
        </mxCell>
