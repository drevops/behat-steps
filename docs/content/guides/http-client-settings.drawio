        <mxCell id="lg-external" value="" style="rounded=1;arcSize=12;html=1;strokeWidth=1.5;fillColor=#ECEFF1;strokeColor=#546E7A;dashed=1;" vertex="1" parent="grp-legend">
          <mxGeometry x="340" y="50" width="40" height="20" as="geometry" />
        </mxCell>
        <mxCell id="lg-external-label" value="External" style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=middle;spacing=0;fontFamily=Helvetica;fontColor=#263238;fontSize=13;" vertex="1" parent="grp-legend">
          <mxGeometry x="395" y="50" width="125" height="20" as="geometry" />
