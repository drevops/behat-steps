        <mxCell id="lg-extension-label" value="Extension layer" style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=middle;spacing=0;fontFamily=Helvetica;fontColor=#263238;fontSize=13;" vertex="1" parent="grp-legend">
          <mxGeometry x="75" y="90" width="240" height="20" as="geometry" />
