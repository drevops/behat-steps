        <mxCell id="lg-travels" value="" style="edgeStyle=none;html=1;strokeColor=#455A64;strokeWidth=1.5;endArrow=block;endFill=1;endSize=8;" edge="1" parent="grp-legend">
          <mxGeometry relative="1" as="geometry"><mxPoint x="340" y="100" as="sourcePoint" /><mxPoint x="380" y="100" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="lg-travels-label" value="a setting travels" style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=middle;spacing=0;fontFamily=Helvetica;fontColor=#263238;fontSize=13;" vertex="1" parent="grp-legend">
          <mxGeometry x="395" y="90" width="125" height="20" as="geometry" />
        </mxCell>
        <mxCell id="e-read" value="read when Mink builds the session" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#455A64;strokeWidth=1.5;endArrow=block;endFill=1;endSize=8;fontFamily=Helvetica;fontSize=11;fontColor=#37474F;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="src-mink" target="factory">
          <mxGeometry relative="1" as="geometry"></mxGeometry>
