<mxfile host="drawio" agent="behat-steps data-flow generator">
  <diagram id="data-flow" name="Data flow">
    <mxGraphModel dx="0" dy="0" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="2400" pageHeight="1200" background="#ffffff" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="Behat Steps: data flow" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontSize=22;fontColor=#1A1A1A;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="30" y="20" width="800" height="30" as="geometry"/></mxCell>
        <mxCell id="subtitle" value="What runs when a suite starts, when a scenario starts, on every step and when a scenario ends. Read the numbers in order: a step&apos;s color says which part of the system runs it." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontSize=13;fontColor=#546E7A;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="30" y="56" width="1700" height="20" as="geometry"/></mxCell>
        <mxCell id="phase-suite" value="&lt;b style=&quot;font-size:15px&quot;&gt;1. Suite starts&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;once per run&lt;/span&gt;" style="swimlane;startSize=50;rounded=1;arcSize=6;html=1;whiteSpace=wrap;container=1;collapsible=0;fillColor=#FAFAFA;swimlaneFillColor=#FAFAFA;strokeColor=#90A4AE;strokeWidth=1.5;fontFamily=Helvetica;fontSize=15;fontColor=#263238;" vertex="1" parent="1"><mxGeometry x="30" y="100" width="360" height="900" as="geometry"/></mxCell>
        <mxCell id="phase-scenario" value="&lt;b style=&quot;font-size:15px&quot;&gt;2. Scenario starts&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;for each scenario&lt;/span&gt;" style="swimlane;startSize=50;rounded=1;arcSize=6;html=1;whiteSpace=wrap;container=1;collapsible=0;fillColor=#FAFAFA;swimlaneFillColor=#FAFAFA;strokeColor=#90A4AE;strokeWidth=1.5;fontFamily=Helvetica;fontSize=15;fontColor=#263238;" vertex="1" parent="1"><mxGeometry x="450" y="100" width="360" height="900" as="geometry"/></mxCell>
        <mxCell id="phase-step" value="&lt;b style=&quot;font-size:15px&quot;&gt;3. Each step&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;for each step of the scenario&lt;/span&gt;" style="swimlane;startSize=50;rounded=1;arcSize=6;html=1;whiteSpace=wrap;container=1;collapsible=0;fillColor=#FAFAFA;swimlaneFillColor=#FAFAFA;strokeColor=#90A4AE;strokeWidth=1.5;fontFamily=Helvetica;fontSize=15;fontColor=#263238;" vertex="1" parent="1"><mxGeometry x="870" y="100" width="1060" height="900" as="geometry"/></mxCell>
        <mxCell id="phase-end" value="&lt;b style=&quot;font-size:15px&quot;&gt;4. Scenario ends&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;after its last step&lt;/span&gt;" style="swimlane;startSize=50;rounded=1;arcSize=6;html=1;whiteSpace=wrap;container=1;collapsible=0;fillColor=#FAFAFA;swimlaneFillColor=#FAFAFA;strokeColor=#90A4AE;strokeWidth=1.5;fontFamily=Helvetica;fontSize=15;fontColor=#263238;" vertex="1" parent="1"><mxGeometry x="1990" y="100" width="360" height="900" as="geometry"/></mxCell>
        <mxCell id="e-phase-suite-phase-scenario" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#455A64;strokeWidth=1.5;fontFamily=Helvetica;fontSize=11;fontColor=#37474F;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;exitX=1;exitY=0.0278;exitDx=0;exitDy=0;entryX=0;entryY=0.0278;entryDx=0;entryDy=0;" edge="1" parent="1" source="phase-suite" target="phase-scenario"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e-phase-scenario-phase-step" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#455A64;strokeWidth=1.5;fontFamily=Helvetica;fontSize=11;fontColor=#37474F;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;exitX=1;exitY=0.0278;exitDx=0;exitDy=0;entryX=0;entryY=0.0278;entryDx=0;entryDy=0;" edge="1" parent="1" source="phase-scenario" target="phase-step"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e-phase-step-phase-end" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#455A64;strokeWidth=1.5;fontFamily=Helvetica;fontSize=11;fontColor=#37474F;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;exitX=1;exitY=0.0278;exitDx=0;exitDy=0;entryX=0;entryY=0.0278;entryDx=0;entryDy=0;" edge="1" parent="1" source="phase-step" target="phase-end"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="s11" value="&lt;b&gt;1.1 Behat reads behat.yml&lt;/b&gt;&lt;br&gt;loads the behat_steps extension" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;strokeWidth=1.5;fillColor=#ECEFF1;strokeColor=#546E7A;dashed=1;fontFamily=Helvetica;fontSize=13;fontColor=#1A1A1A;spacing=8;" vertex="1" parent="phase-suite"><mxGeometry x="30" y="70" width="300" height="80" as="geometry"/></mxCell>
        <mxCell id="s12" value="&lt;b&gt;1.2 BehatStepsExtension&lt;/b&gt;&lt;br&gt;registers the configured backends; wires the registries, listeners and initializer" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;strokeWidth=1.5;fillColor=#F3E5F5;strokeColor=#6A1B9A;dashed=0;fontFamily=Helvetica;fontSize=13;fontColor=#1A1A1A;spacing=8;" vertex="1" parent="phase-suite"><mxGeometry x="30" y="200" width="300" height="80" as="geometry"/></mxCell>
        <mxCell id="s13" value="&lt;b&gt;1.3 WebContext::assertOneContext()&lt;/b&gt;&lt;br&gt;fails a suite that registers 2 shipped contexts" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;strokeWidth=1.5;fillColor=#FFF8E1;strokeColor=#F9A825;dashed=0;fontFamily=Helvetica;fontSize=13;fontColor=#1A1A1A;spacing=8;" vertex="1" parent="phase-suite"><mxGeometry x="30" y="330" width="300" height="80" as="geometry"/></mxCell>
        <mxCell id="s21" value="&lt;b&gt;2.1 Behat builds fresh contexts&lt;/b&gt;&lt;br&gt;1 set per scenario" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;strokeWidth=1.5;fillColor=#ECEFF1;strokeColor=#546E7A;dashed=1;fontFamily=Helvetica;fontSize=13;fontColor=#1A1A1A;spacing=8;" vertex="1" parent="phase-scenario"><mxGeometry x="30" y="70" width="300" height="80" as="geometry"/></mxCell>
        <mxCell id="s22" value="&lt;b&gt;2.2 BackendAwareInitializer&lt;/b&gt;&lt;br&gt;injects the registries, parameters, authenticators and HTTP client factory" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;strokeWidth=1.5;fillColor=#F3E5F5;strokeColor=#6A1B9A;dashed=0;fontFamily=Helvetica;fontSize=13;fontColor=#1A1A1A;spacing=8;" vertex="1" parent="phase-scenario"><mxGeometry x="30" y="200" width="300" height="80" as="geometry"/></mxCell>
        <mxCell id="s23" value="&lt;b&gt;2.3 SkipTagListener&lt;/b&gt;&lt;br&gt;rejects a @behat-steps-skip: tag that names no composed trait" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;strokeWidth=1.5;fillColor=#F3E5F5;strokeColor=#6A1B9A;dashed=0;fontFamily=Helvetica;fontSize=13;fontColor=#1A1A1A;spacing=8;" vertex="1" parent="phase-scenario"><mxGeometry x="30" y="330" width="300" height="80" as="geometry"/></mxCell>
        <mxCell id="s24" value="&lt;b&gt;2.4 BackendListener&lt;/b&gt;&lt;br&gt;gives BackendRegistry the backend order: @backend: tags first, then the configured list" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;strokeWidth=1.5;fillColor=#F3E5F5;strokeColor=#6A1B9A;dashed=0;fontFamily=Helvetica;fontSize=13;fontColor=#1A1A1A;spacing=8;" vertex="1" parent="phase-scenario"><mxGeometry x="30" y="460" width="300" height="80" as="geometry"/></mxCell>
        <mxCell id="s25" value="&lt;b&gt;2.5 BeforeScenario hooks&lt;/b&gt;&lt;br&gt;skipTag() skips a switched-off trait; assertPrerequisites() fails what the site can&apos;t run" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;strokeWidth=1.5;fillColor=#E3F2FD;strokeColor=#1565C0;dashed=0;fontFamily=Helvetica;fontSize=13;fontColor=#1A1A1A;spacing=8;" vertex="1" parent="phase-scenario"><mxGeometry x="30" y="590" width="300" height="80" as="geometry"/></mxCell>
        <mxCell id="s31" value="&lt;b&gt;3.1 Behat matches the Gherkin line&lt;/b&gt;&lt;br&gt;to a #[Given], #[When] or #[Then] attribute on a trait method" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;strokeWidth=1.5;fillColor=#ECEFF1;strokeColor=#546E7A;dashed=1;fontFamily=Helvetica;fontSize=13;fontColor=#1A1A1A;spacing=8;" vertex="1" parent="phase-step"><mxGeometry x="380" y="70" width="300" height="80" as="geometry"/></mxCell>
        <mxCell id="s32" value="&lt;b&gt;3.2 The step method runs&lt;/b&gt;&lt;br&gt;on the context: parses its arguments, calls helpers, takes 1 of 3 paths" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;strokeWidth=1.5;fillColor=#E3F2FD;strokeColor=#1565C0;dashed=0;fontFamily=Helvetica;fontSize=13;fontColor=#1A1A1A;spacing=8;" vertex="1" parent="phase-step"><mxGeometry x="380" y="200" width="300" height="80" as="geometry"/></mxCell>
        <mxCell id="s33a" value="&lt;b&gt;3.3a Mink session&lt;/b&gt;&lt;br&gt;getSession(); browserDriverFor() for a capability such as JavaScript" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;strokeWidth=1.5;fillColor=#ECEFF1;strokeColor=#546E7A;dashed=1;fontFamily=Helvetica;fontSize=13;fontColor=#1A1A1A;spacing=8;" vertex="1" parent="phase-step"><mxGeometry x="30" y="360" width="300" height="80" as="geometry"/></mxCell>
        <mxCell id="s34a" value="&lt;b&gt;3.4a The page&lt;/b&gt;&lt;br&gt;a request through BrowserKit, Selenium2 or Chrome" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;strokeWidth=1.5;fillColor=#ECEFF1;strokeColor=#546E7A;dashed=1;fontFamily=Helvetica;fontSize=13;fontColor=#1A1A1A;spacing=8;" vertex="1" parent="phase-step"><mxGeometry x="30" y="490" width="300" height="80" as="geometry"/></mxCell>
        <mxCell id="s33b" value="&lt;b&gt;3.3b backendFor()&lt;/b&gt;&lt;br&gt;BackendRegistry returns the first backend in the order that provides the capability" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;strokeWidth=1.5;fillColor=#F3E5F5;strokeColor=#6A1B9A;dashed=0;fontFamily=Helvetica;fontSize=13;fontColor=#1A1A1A;spacing=8;" vertex="1" parent="phase-step"><mxGeometry x="380" y="360" width="300" height="80" as="geometry"/></mxCell>
        <mxCell id="s34b" value="&lt;b&gt;3.4b DrupalBackend or DrushBackend&lt;/b&gt;&lt;br&gt;Core and its field handlers turn a stub into an entity, or drush runs a command" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;strokeWidth=1.5;fillColor=#E8F5E9;strokeColor=#2E7D32;dashed=0;fontFamily=Helvetica;fontSize=13;fontColor=#1A1A1A;spacing=8;" vertex="1" parent="phase-step"><mxGeometry x="380" y="490" width="300" height="80" as="geometry"/></mxCell>
        <mxCell id="s35b" value="&lt;b&gt;3.5b Drupal and its database&lt;/b&gt;&lt;br&gt;the site under test" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;strokeWidth=1.5;fillColor=#ECEFF1;strokeColor=#546E7A;dashed=1;fontFamily=Helvetica;fontSize=13;fontColor=#1A1A1A;spacing=8;" vertex="1" parent="phase-step"><mxGeometry x="380" y="620" width="300" height="80" as="geometry"/></mxCell>
        <mxCell id="s33c" value="&lt;b&gt;3.3c An HTTP client&lt;/b&gt;&lt;br&gt;httpPageClient(), httpDetachedClient() or httpBareClient()" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;strokeWidth=1.5;fillColor=#F3E5F5;strokeColor=#6A1B9A;dashed=0;fontFamily=Helvetica;fontSize=13;fontColor=#1A1A1A;spacing=8;" vertex="1" parent="phase-step"><mxGeometry x="730" y="360" width="300" height="80" as="geometry"/></mxCell>
        <mxCell id="s34c" value="&lt;b&gt;3.4c The response&lt;/b&gt;&lt;br&gt;a download, a REST call, a file from a CDN" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;strokeWidth=1.5;fillColor=#ECEFF1;strokeColor=#546E7A;dashed=1;fontFamily=Helvetica;fontSize=13;fontColor=#1A1A1A;spacing=8;" vertex="1" parent="phase-step"><mxGeometry x="730" y="490" width="300" height="80" as="geometry"/></mxCell>
        <mxCell id="s36" value="&lt;b&gt;3.6 Assert&lt;/b&gt;&lt;br&gt;passes, or throws ExpectationException,&lt;br&gt;AssertionException or UnsupportedBackendActionException" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;strokeWidth=1.5;fillColor=#E3F2FD;strokeColor=#1565C0;dashed=0;fontFamily=Helvetica;fontSize=13;fontColor=#1A1A1A;spacing=8;" vertex="1" parent="phase-step"><mxGeometry x="320" y="770" width="420" height="80" as="geometry"/></mxCell>
        <mxCell id="s41" value="&lt;b&gt;4.1 AfterScenario cleanup&lt;/b&gt;&lt;br&gt;EntityLifecycleTrait: created entities, newest first. AuthTrait: users, then roles" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;strokeWidth=1.5;fillColor=#E3F2FD;strokeColor=#1565C0;dashed=0;fontFamily=Helvetica;fontSize=13;fontColor=#1A1A1A;spacing=8;" vertex="1" parent="phase-end"><mxGeometry x="30" y="70" width="300" height="80" as="geometry"/></mxCell>
        <mxCell id="s42" value="&lt;b&gt;4.2 The backends delete them&lt;/b&gt;&lt;br&gt;backendFor() each delete capability; a type no backend deletes stays" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;strokeWidth=1.5;fillColor=#E8F5E9;strokeColor=#2E7D32;dashed=0;fontFamily=Helvetica;fontSize=13;fontColor=#1A1A1A;spacing=8;" vertex="1" parent="phase-end"><mxGeometry x="30" y="200" width="300" height="80" as="geometry"/></mxCell>
        <mxCell id="s43" value="&lt;b&gt;4.3 Drupal and its database&lt;/b&gt;&lt;br&gt;the scenario&apos;s entities are gone" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;strokeWidth=1.5;fillColor=#ECEFF1;strokeColor=#546E7A;dashed=1;fontFamily=Helvetica;fontSize=13;fontColor=#1A1A1A;spacing=8;" vertex="1" parent="phase-end"><mxGeometry x="30" y="330" width="300" height="80" as="geometry"/></mxCell>
        <mxCell id="e-s11-s12" value="loads" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#455A64;strokeWidth=1.5;fontFamily=Helvetica;fontSize=11;fontColor=#37474F;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="s11" target="s12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e-s12-s13" value="BeforeSuite" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#455A64;strokeWidth=1.5;fontFamily=Helvetica;fontSize=11;fontColor=#37474F;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="s12" target="s13"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e-s21-s22" value="each context" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#455A64;strokeWidth=1.5;fontFamily=Helvetica;fontSize=11;fontColor=#37474F;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="s21" target="s22"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e-s22-s23" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#455A64;strokeWidth=1.5;fontFamily=Helvetica;fontSize=11;fontColor=#37474F;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="s22" target="s23"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e-s23-s24" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#455A64;strokeWidth=1.5;fontFamily=Helvetica;fontSize=11;fontColor=#37474F;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="s23" target="s24"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e-s24-s25" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#455A64;strokeWidth=1.5;fontFamily=Helvetica;fontSize=11;fontColor=#37474F;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="s24" target="s25"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e-s31-s32" value="calls" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#455A64;strokeWidth=1.5;fontFamily=Helvetica;fontSize=11;fontColor=#37474F;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="s31" target="s32"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e-s32-s33a" value="A: the page" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#455A64;strokeWidth=1.5;fontFamily=Helvetica;fontSize=11;fontColor=#37474F;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;exitX=0.25;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="s32" target="s33a"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1325" y="420"/><mxPoint x="1050" y="420"/></Array></mxGeometry></mxCell>
        <mxCell id="e-s32-s33b" value="B: site state" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#455A64;strokeWidth=1.5;fontFamily=Helvetica;fontSize=11;fontColor=#37474F;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="s32" target="s33b"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e-s32-s33c" value="C: a request of its own" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#455A64;strokeWidth=1.5;fontFamily=Helvetica;fontSize=11;fontColor=#37474F;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;exitX=0.75;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="s32" target="s33c"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1475" y="420"/><mxPoint x="1750" y="420"/></Array></mxGeometry></mxCell>
        <mxCell id="e-s33a-s34a" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#455A64;strokeWidth=1.5;fontFamily=Helvetica;fontSize=11;fontColor=#37474F;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="s33a" target="s34a"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e-s33b-s34b" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#455A64;strokeWidth=1.5;fontFamily=Helvetica;fontSize=11;fontColor=#37474F;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="s33b" target="s34b"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e-s34b-s35b" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#455A64;strokeWidth=1.5;fontFamily=Helvetica;fontSize=11;fontColor=#37474F;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="s34b" target="s35b"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e-s33c-s34c" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#455A64;strokeWidth=1.5;fontFamily=Helvetica;fontSize=11;fontColor=#37474F;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="s33c" target="s34c"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
