<mxfile host="drawio" version="26.0.0">
  <diagram id="data-flow" name="Data flow">
    <mxGraphModel dx="0" dy="0" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="2380" pageHeight="1430" background="#ffffff" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="Behat Steps: data flow" style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=middle;spacing=0;fontFamily=Helvetica;strokeColor=none;fillColor=none;fontSize=22;fontStyle=1;fontColor=#263238;" vertex="1" parent="1">
          <mxGeometry x="16" y="16" width="900" height="34" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="Read the numbers in order. The 4 columns are the phases of a run, and the 3 bands say whose code runs each part." style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=middle;spacing=0;fontFamily=Helvetica;strokeColor=none;fillColor=none;fontSize=13;fontColor=#546E7A;" vertex="1" parent="1">
          <mxGeometry x="16" y="54" width="1700" height="22" as="geometry" />
        </mxCell>
        <mxCell id="ph-suite" value="&lt;font style=&quot;font-size: 15px;&quot;&gt;&lt;b&gt;1. Suite starts&lt;/b&gt;&lt;/font&gt;&lt;br&gt;once per run" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;strokeWidth=1.5;fontFamily=Helvetica;fontSize=12;fontColor=#263238;spacing=8;fillColor=#ffffff;strokeColor=#455A64;" vertex="1" parent="1">
          <mxGeometry x="40" y="100" width="380" height="56" as="geometry" />
        </mxCell>
        <mxCell id="ph-scenario" value="&lt;font style=&quot;font-size: 15px;&quot;&gt;&lt;b&gt;2. Scenario starts&lt;/b&gt;&lt;/font&gt;&lt;br&gt;for each scenario" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;strokeWidth=1.5;fontFamily=Helvetica;fontSize=12;fontColor=#263238;spacing=8;fillColor=#ffffff;strokeColor=#455A64;" vertex="1" parent="1">
          <mxGeometry x="450" y="100" width="380" height="56" as="geometry" />
        </mxCell>
        <mxCell id="ph-step" value="&lt;font style=&quot;font-size: 15px;&quot;&gt;&lt;b&gt;3. Each step&lt;/b&gt;&lt;/font&gt;&lt;br&gt;for each step of the scenario" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;strokeWidth=1.5;fontFamily=Helvetica;fontSize=12;fontColor=#263238;spacing=8;fillColor=#ffffff;strokeColor=#455A64;" vertex="1" parent="1">
          <mxGeometry x="860" y="100" width="1040" height="56" as="geometry" />
        </mxCell>
        <mxCell id="ph-end" value="&lt;font style=&quot;font-size: 15px;&quot;&gt;&lt;b&gt;4. Scenario ends&lt;/b&gt;&lt;/font&gt;&lt;br&gt;after its last step" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;strokeWidth=1.5;fontFamily=Helvetica;fontSize=12;fontColor=#263238;spacing=8;fillColor=#ffffff;strokeColor=#455A64;" vertex="1" parent="1">
          <mxGeometry x="1930" y="100" width="410" height="56" as="geometry" />
        </mxCell>
        <mxCell id="e-ph-1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=1.5;fontFamily=Helvetica;fontSize=11;fontColor=#37474F;labelBackgroundColor=#ffffff;endSize=8;strokeColor=#455A64;endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="ph-suite" target="ph-scenario">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-ph-2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=1.5;fontFamily=Helvetica;fontSize=11;fontColor=#37474F;labelBackgroundColor=#ffffff;endSize=8;strokeColor=#455A64;endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="ph-scenario" target="ph-step">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-ph-3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=1.5;fontFamily=Helvetica;fontSize=11;fontColor=#37474F;labelBackgroundColor=#ffffff;endSize=8;strokeColor=#455A64;endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="ph-step" target="ph-end">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="band-behat" value="Behat and Mink: run the suite, match each step and drive the browser" style="swimlane;startSize=30;rounded=1;arcSize=6;html=1;whiteSpace=wrap;collapsible=0;fontFamily=Helvetica;fontSize=15;fontStyle=1;fontColor=#263238;align=left;spacingLeft=10;fillColor=#ECEFF1;swimlaneFillColor=#ECEFF1;strokeColor=#546E7A;strokeWidth=1.5;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="20" y="180" width="2340" height="300" as="geometry" />
        </mxCell>
        <mxCell id="band-steps" value="Behat Steps: drevops/behat-steps" style="swimlane;startSize=30;rounded=1;arcSize=6;html=1;whiteSpace=wrap;collapsible=0;fontFamily=Helvetica;fontSize=15;fontStyle=1;fontColor=#263238;align=left;spacingLeft=10;fillColor=#ffffff;swimlaneFillColor=#ffffff;strokeColor=#263238;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="20" y="500" width="2340" height="540" as="geometry" />
        </mxCell>
        <mxCell id="band-site" value="The site under test" style="swimlane;startSize=30;rounded=1;arcSize=6;html=1;whiteSpace=wrap;collapsible=0;fontFamily=Helvetica;fontSize=15;fontStyle=1;fontColor=#263238;align=left;spacingLeft=10;fillColor=#ECEFF1;swimlaneFillColor=#ECEFF1;strokeColor=#546E7A;strokeWidth=1.5;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="20" y="1060" width="2340" height="170" as="geometry" />
        </mxCell>
        <mxCell id="n-1-1" value="&lt;b&gt;1.1 Behat reads behat.php&lt;/b&gt;&lt;br&gt;loads BehatStepsExtension and your suites" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;strokeWidth=1.5;fontFamily=Helvetica;fontSize=13;fontColor=#263238;spacing=8;fillColor=#ffffff;strokeColor=#546E7A;dashed=1;" vertex="1" parent="band-behat">
          <mxGeometry x="60" y="50" width="300" height="70" as="geometry" />
        </mxCell>
        <mxCell id="n-2-1" value="&lt;b&gt;2.1 Behat builds fresh contexts&lt;/b&gt;&lt;br&gt;1 set per scenario,&lt;br&gt;before its events and hooks" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;strokeWidth=1.5;fontFamily=Helvetica;fontSize=13;fontColor=#263238;spacing=8;fillColor=#ffffff;strokeColor=#546E7A;dashed=1;" vertex="1" parent="band-behat">
          <mxGeometry x="470" y="50" width="300" height="70" as="geometry" />
        </mxCell>
        <mxCell id="n-3-1" value="&lt;b&gt;3.1 Behat matches the Gherkin line&lt;/b&gt;&lt;br&gt;to a #[Given], #[When] or #[Then] attribute,&lt;br&gt;and calls the method" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;strokeWidth=1.5;fontFamily=Helvetica;fontSize=13;fontColor=#263238;spacing=8;fillColor=#ffffff;strokeColor=#546E7A;dashed=1;" vertex="1" parent="band-behat">
          <mxGeometry x="1210" y="50" width="300" height="80" as="geometry" />
        </mxCell>
        <mxCell id="n-3-3a" value="&lt;b&gt;3.3a Mink session&lt;/b&gt;&lt;br&gt;getSession() drives the browser driver:&lt;br&gt;BrowserKit, Selenium2 or Chrome" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;strokeWidth=1.5;fontFamily=Helvetica;fontSize=13;fontColor=#263238;spacing=8;fillColor=#ffffff;strokeColor=#546E7A;dashed=1;" vertex="1" parent="band-behat">
          <mxGeometry x="870" y="200" width="300" height="80" as="geometry" />
        </mxCell>
        <mxCell id="n-4-1" value="&lt;b&gt;4.1 Behat runs AfterScenario&lt;/b&gt;&lt;br&gt;the hooks of every context,&lt;br&gt;after the last step" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;strokeWidth=1.5;fontFamily=Helvetica;fontSize=13;fontColor=#263238;spacing=8;fillColor=#ffffff;strokeColor=#546E7A;dashed=1;" vertex="1" parent="band-behat">
          <mxGeometry x="1965" y="50" width="300" height="70" as="geometry" />
        </mxCell>
        <mxCell id="n-1-2" value="&lt;b&gt;1.2 BehatStepsExtension&lt;/b&gt;&lt;br&gt;registers the configured backends;&lt;br&gt;wires the registries, listeners and initializer" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;strokeWidth=1.5;fontFamily=Helvetica;fontSize=13;fontColor=#263238;spacing=8;fillColor=#ffffff;strokeColor=#6A1B9A;" vertex="1" parent="band-steps">
          <mxGeometry x="60" y="50" width="300" height="80" as="geometry" />
        </mxCell>
        <mxCell id="n-1-3" value="&lt;b&gt;1.3 WebContext::assertOneContext()&lt;/b&gt;&lt;br&gt;a BeforeSuite hook: fails a suite&lt;br&gt;with 2 contexts built on WebContext" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;strokeWidth=1.5;fontFamily=Helvetica;fontSize=13;fontColor=#263238;spacing=8;fillColor=#ffffff;strokeColor=#F9A825;" vertex="1" parent="band-steps">
          <mxGeometry x="60" y="190" width="300" height="80" as="geometry" />
        </mxCell>
        <mxCell id="n-2-2" value="&lt;b&gt;2.2 BackendAwareInitializer&lt;/b&gt;&lt;br&gt;injects the registries, parameters,&lt;br&gt;authenticators and HTTP client factory" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;strokeWidth=1.5;fontFamily=Helvetica;fontSize=13;fontColor=#263238;spacing=8;fillColor=#ffffff;strokeColor=#6A1B9A;" vertex="1" parent="band-steps">
          <mxGeometry x="470" y="50" width="300" height="80" as="geometry" />
        </mxCell>
        <mxCell id="n-2-3" value="&lt;b&gt;2.3 SkipTagListener&lt;/b&gt;&lt;br&gt;rejects a @behat-steps-skip: tag&lt;br&gt;that names no composed trait" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;strokeWidth=1.5;fontFamily=Helvetica;fontSize=13;fontColor=#263238;spacing=8;fillColor=#ffffff;strokeColor=#6A1B9A;" vertex="1" parent="band-steps">
          <mxGeometry x="470" y="160" width="300" height="80" as="geometry" />
        </mxCell>
        <mxCell id="n-2-4" value="&lt;b&gt;2.4 BackendListener&lt;/b&gt;&lt;br&gt;the backend order:&lt;br&gt;@backend: tags first, then the configured list" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;strokeWidth=1.5;fontFamily=Helvetica;fontSize=13;fontColor=#263238;spacing=8;fillColor=#ffffff;strokeColor=#6A1B9A;" vertex="1" parent="band-steps">
          <mxGeometry x="470" y="270" width="300" height="80" as="geometry" />
        </mxCell>
        <mxCell id="n-2-5" value="&lt;b&gt;2.5 BeforeScenario hooks&lt;/b&gt;&lt;br&gt;skipTag() skips a switched-off trait;&lt;br&gt;assertPrerequisites() fails what the site can't run" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;strokeWidth=1.5;fontFamily=Helvetica;fontSize=13;fontColor=#263238;spacing=8;fillColor=#ffffff;strokeColor=#1565C0;" vertex="1" parent="band-steps">
          <mxGeometry x="470" y="380" width="300" height="80" as="geometry" />
        </mxCell>
        <mxCell id="n-3-2" value="&lt;b&gt;3.2 The step method runs&lt;/b&gt;&lt;br&gt;parses its arguments, calls helpers, takes&lt;br&gt;1 of 3 paths, then asserts on what comes back" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;strokeWidth=1.5;fontFamily=Helvetica;fontSize=13;fontColor=#263238;spacing=8;fillColor=#ffffff;strokeColor=#1565C0;" vertex="1" parent="band-steps">
          <mxGeometry x="1210" y="50" width="300" height="80" as="geometry" />
        </mxCell>
        <mxCell id="n-3-3b" value="&lt;b&gt;3.3b backendFor()&lt;/b&gt;&lt;br&gt;BackendRegistry returns the first backend&lt;br&gt;in the order that provides the capability" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;strokeWidth=1.5;fontFamily=Helvetica;fontSize=13;fontColor=#263238;spacing=8;fillColor=#ffffff;strokeColor=#6A1B9A;" vertex="1" parent="band-steps">
          <mxGeometry x="1210" y="190" width="300" height="80" as="geometry" />
        </mxCell>
        <mxCell id="n-3-4b" value="&lt;b&gt;3.4b DrupalBackend or DrushBackend&lt;/b&gt;&lt;br&gt;Core turns a stub into an entity,&lt;br&gt;or drush runs a command" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;strokeWidth=1.5;fontFamily=Helvetica;fontSize=13;fontColor=#263238;spacing=8;fillColor=#ffffff;strokeColor=#2E7D32;" vertex="1" parent="band-steps">
          <mxGeometry x="1210" y="330" width="300" height="80" as="geometry" />
        </mxCell>
        <mxCell id="n-3-3c" value="&lt;b&gt;3.3c An HTTP client&lt;/b&gt;&lt;br&gt;httpRestSession(), httpPageClient(),&lt;br&gt;httpDetachedClient() or httpBareClient()" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;strokeWidth=1.5;fontFamily=Helvetica;fontSize=13;fontColor=#263238;spacing=8;fillColor=#ffffff;strokeColor=#6A1B9A;" vertex="1" parent="band-steps">
          <mxGeometry x="1550" y="190" width="300" height="80" as="geometry" />
        </mxCell>
        <mxCell id="n-4-2" value="&lt;b&gt;4.2 Cleanup&lt;/b&gt;&lt;br&gt;EntityLifecycleTrait: registered entities,&lt;br&gt;newest first; AuthTrait: users, then roles" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;strokeWidth=1.5;fontFamily=Helvetica;fontSize=13;fontColor=#263238;spacing=8;fillColor=#ffffff;strokeColor=#1565C0;" vertex="1" parent="band-steps">
          <mxGeometry x="1965" y="50" width="300" height="80" as="geometry" />
        </mxCell>
        <mxCell id="n-4-3" value="&lt;b&gt;4.3 The backends delete them&lt;/b&gt;&lt;br&gt;each through its delete capability;&lt;br&gt;a type no backend deletes stays" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;strokeWidth=1.5;fontFamily=Helvetica;fontSize=13;fontColor=#263238;spacing=8;fillColor=#ffffff;strokeColor=#2E7D32;" vertex="1" parent="band-steps">
          <mxGeometry x="1965" y="190" width="300" height="80" as="geometry" />
        </mxCell>
        <mxCell id="n-3-4a" value="&lt;b&gt;3.4a The page&lt;/b&gt;&lt;br&gt;the site answers the browser's request" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;strokeWidth=1.5;fontFamily=Helvetica;fontSize=13;fontColor=#263238;spacing=8;fillColor=#ffffff;strokeColor=#546E7A;dashed=1;" vertex="1" parent="band-site">
          <mxGeometry x="870" y="50" width="300" height="70" as="geometry" />
        </mxCell>
        <mxCell id="n-3-5b" value="&lt;b&gt;3.5b Drupal and its database&lt;/b&gt;&lt;br&gt;what the backend reads and changes" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;strokeWidth=1.5;fontFamily=Helvetica;fontSize=13;fontColor=#263238;spacing=8;fillColor=#ffffff;strokeColor=#546E7A;dashed=1;" vertex="1" parent="band-site">
          <mxGeometry x="1210" y="50" width="300" height="70" as="geometry" />
        </mxCell>
        <mxCell id="n-3-4c" value="&lt;b&gt;3.4c The response&lt;/b&gt;&lt;br&gt;a download, a REST call, a file from a CDN" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;strokeWidth=1.5;fontFamily=Helvetica;fontSize=13;fontColor=#263238;spacing=8;fillColor=#ffffff;strokeColor=#546E7A;dashed=1;" vertex="1" parent="band-site">
          <mxGeometry x="1550" y="50" width="300" height="70" as="geometry" />
        </mxCell>
        <mxCell id="n-4-4" value="&lt;b&gt;4.4 The site is clean again&lt;/b&gt;&lt;br&gt;the scenario's entities are gone" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;strokeWidth=1.5;fontFamily=Helvetica;fontSize=13;fontColor=#263238;spacing=8;fillColor=#ffffff;strokeColor=#546E7A;dashed=1;" vertex="1" parent="band-site">
          <mxGeometry x="1965" y="50" width="300" height="70" as="geometry" />
        </mxCell>
        <mxCell id="e-1-1" value="loads" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=1.5;fontFamily=Helvetica;fontSize=11;fontColor=#37474F;labelBackgroundColor=#ffffff;endSize=8;strokeColor=#455A64;endArrow=block;endFill=1;exitX=0.75;exitY=1;exitDx=0;exitDy=0;entryX=0.75;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n-1-1" target="n-1-2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-1-2" value="BeforeSuite" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=1.5;fontFamily=Helvetica;fontSize=11;fontColor=#37474F;labelBackgroundColor=#ffffff;endSize=8;strokeColor=#455A64;endArrow=block;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n-1-2" target="n-1-3">
