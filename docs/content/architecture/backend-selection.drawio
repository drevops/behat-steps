<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="drawio" version="26.0.0">
  <diagram id="backend-selection" name="Backend selection">
    <mxGraphModel dx="0" dy="0" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="2400" pageHeight="860" background="#ffffff" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="Behat Steps: backend selection" style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=middle;spacing=0;fontFamily=Helvetica;fontColor=#263238;fontSize=22;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="16" y="16" width="900" height="34" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="A step asks for a capability, never for a backend. The first backend in the scenario's order that provides the capability does the work." style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=middle;spacing=0;fontFamily=Helvetica;fontColor=#263238;fontSize=13;fontColor=#546E7A;" vertex="1" parent="1">
          <mxGeometry x="16" y="54" width="1500" height="22" as="geometry" />
        </mxCell>
        <mxCell id="step" value="&lt;b&gt;Given the cache has been cleared&lt;/b&gt;&lt;br&gt;CacheTrait calls backendFor() with CacheCapabilityInterface" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;strokeWidth=1.5;fontFamily=Helvetica;fontSize=13;fontColor=#263238;spacing=8;fillColor=#E3F2FD;strokeColor=#1565C0;" vertex="1" parent="1">
          <mxGeometry x="40" y="140" width="300" height="90" as="geometry" />
        </mxCell>
        <mxCell id="registry" value="&lt;b&gt;BackendRegistry::getBackendFor()&lt;/b&gt;&lt;br&gt;walks the scenario's backends in order, asking each with instanceof" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;strokeWidth=1.5;fontFamily=Helvetica;fontSize=13;fontColor=#263238;spacing=8;fillColor=#F3E5F5;strokeColor=#6A1B9A;" vertex="1" parent="1">
          <mxGeometry x="500" y="140" width="300" height="90" as="geometry" />
        </mxCell>
        <mxCell id="listener" value="&lt;b&gt;BackendListener&lt;/b&gt;&lt;br&gt;at scenario start: @backend: tags first, then the backends list in behat.php" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;strokeWidth=1.5;fontFamily=Helvetica;fontSize=13;fontColor=#263238;spacing=8;fillColor=#F3E5F5;strokeColor=#6A1B9A;" vertex="1" parent="1">
          <mxGeometry x="500" y="320" width="300" height="90" as="geometry" />
        </mxCell>
        <mxCell id="cand-1" value="&lt;b&gt;1st in the order: drupal&lt;/b&gt;&lt;br&gt;DrupalBackend, 34 of the 35 capabilities" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;strokeWidth=1.5;fontFamily=Helvetica;fontSize=13;fontColor=#263238;spacing=8;fillColor=#E8F5E9;strokeColor=#2E7D32;" vertex="1" parent="1">
          <mxGeometry x="900" y="140" width="280" height="90" as="geometry" />
        </mxCell>
        <mxCell id="cand-2" value="&lt;b&gt;2nd: drush&lt;/b&gt;&lt;br&gt;DrushBackend, 14 capabilities" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;strokeWidth=1.5;fontFamily=Helvetica;fontSize=13;fontColor=#263238;spacing=8;fillColor=#E8F5E9;strokeColor=#2E7D32;" vertex="1" parent="1">
          <mxGeometry x="1290" y="140" width="280" height="90" as="geometry" />
        </mxCell>
        <mxCell id="cand-3" value="&lt;b&gt;3rd: blackbox&lt;/b&gt;&lt;br&gt;BlackboxBackend, no capabilities: a site you can only browse" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;strokeWidth=1.5;fontFamily=Helvetica;fontSize=13;fontColor=#263238;spacing=8;fillColor=#E8F5E9;strokeColor=#2E7D32;" vertex="1" parent="1">
          <mxGeometry x="1680" y="140" width="280" height="90" as="geometry" />
        </mxCell>
        <mxCell id="none" value="&lt;b&gt;UnsupportedBackendActionException&lt;/b&gt;&lt;br&gt;names the capability and the scenario's order" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;strokeWidth=1.5;fontFamily=Helvetica;fontSize=13;fontColor=#263238;spacing=8;fillColor=#FFEBEE;strokeColor=#C62828;" vertex="1" parent="1">
          <mxGeometry x="2070" y="140" width="300" height="90" as="geometry" />
        </mxCell>
        <mxCell id="run-1" value="&lt;b&gt;Runs in-process&lt;/b&gt;&lt;br&gt;bootstrapped the first time a step needs it; Core clears every cache" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;strokeWidth=1.5;fontFamily=Helvetica;fontSize=13;fontColor=#263238;spacing=8;fillColor=#E8F5E9;strokeColor=#2E7D32;" vertex="1" parent="1">
          <mxGeometry x="900" y="320" width="280" height="90" as="geometry" />
        </mxCell>
        <mxCell id="run-2" value="&lt;b&gt;Runs over Drush&lt;/b&gt;&lt;br&gt;drush cache:rebuild" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;strokeWidth=1.5;fontFamily=Helvetica;fontSize=13;fontColor=#263238;spacing=8;fillColor=#E8F5E9;strokeColor=#2E7D32;" vertex="1" parent="1">
          <mxGeometry x="1290" y="320" width="280" height="90" as="geometry" />
        </mxCell>
        <mxCell id="note" value="With backends [drupal, drush, blackbox], the step runs in-process. Tag a scenario @backend:drush and drush comes first, so the same step runs over Drush. A backend of your own serves the step as soon as it implements CacheCapabilityInterface." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#FFFFFF;strokeColor=#546E7A;fontFamily=Helvetica;fontSize=12;fontColor=#263238;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=10;" vertex="1" parent="1">
          <mxGeometry x="900" y="480" width="1060" height="76" as="geometry" />
        </mxCell>
        <mxCell id="grp-legend" value="Legend" style="swimlane;startSize=30;rounded=1;arcSize=6;html=1;whiteSpace=wrap;collapsible=0;fontFamily=Helvetica;fontSize=15;fontStyle=1;fontColor=#263238;align=left;spacingLeft=10;strokeWidth=1.5;fillColor=#FFFFFF;swimlaneFillColor=#FFFFFF;strokeColor=#455A64;" vertex="1" parent="1">
          <mxGeometry x="1890" y="620" width="480" height="210" as="geometry" />
