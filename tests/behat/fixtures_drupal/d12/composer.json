{
    "name": "myorg/mysite",
    "description": "Drupal 12 site for MYSITE",
    "license": "proprietary",
    "type": "project",
    "require": {
        "php": ">=8.5",
        "composer/installers": "^2.3",
        "cweagans/composer-patches": "^1.7.3",
        "drupal/core-composer-scaffold": "~12.0.0-alpha1",
        "drupal/core-project-message": "~12.0.0-alpha1",
        "drupal/core-recommended": "~12.0.0-alpha1",
        "mglaman/composer-drupal-lenient": "^2.0",
        "symfony/browser-kit": "^8.1",
        "symfony/config": "^8.1",
        "drupal/mailsystem": "^4.5.0",
        "drupal/draggableviews": "^2.1.4",
        "drupal/dynamic_entity_reference": "^3.2.3",
        "drupal/eck": "^2.1.0",
        "drupal/paragraphs": "^1.23.0",
        "drupal/pathauto": "^1.15.0",
        "drupal/redirect": "^1.13.0",
        "drupal/scheduled_transitions": "^2.9.0-beta4",
        "drupal/search_api": "^1.41.0",
        "drupal/testmode": "^2.7.2",
        "drupal/webform": "^6.3.0",
        "drush/drush": "^14@dev",
        "oomphinc/composer-installers-extender": "^2.0.1",
        "webflo/drupal-finder": "^1.3.1",
        "drupal/text_with_summary": "^1.0.0",
        "drupal/ctools": "^4.1.1",
        "drupal/date_recur": "^3.9.3",
        "drupal/entity_reference_revisions": "^1.14.0",
        "drupal/profile": "^1.14.0",
        "drupal/state_machine": "^1.14.0",
        "drupal/token": "^1.17.0",
        "drupal/entity": "^1.8.0",
        "drupal/inline_entity_form": "^3.0.0",
        "drupal/rat": "^1.0.1"
    },
    "require-dev": {
        "drupal/address": "^2.0.4",
        "drupal/commerce": "^3.3.9",
        "drupal/core-dev": "~12.0.0-alpha1",
        "drupal/date_recur": "^3.9.3",
        "drupal/name": "^1.5.0",
        "drupal/smart_date": "^4.3.0",
        "drupal/supported_image": "^1.0.0-beta1",
        "drupal/time_field": "^2.2.1",
        "phpunit/php-code-coverage": "^12.0"
    },
    "conflict": {
        "drupal/core": "^7.0"
    },
    "repositories": {
        "drupal": {
            "type": "composer",
            "url": "https://packages.drupal.org/8"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "autoload": {
        "classmap": [
            "scripts/composer/"
        ]
    },
    "config": {
        "process-timeout": 0,
        "sort-packages": true,
        "allow-plugins": {
            "composer/installers": true,
            "cweagans/composer-patches": true,
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "drupal/core-composer-scaffold": true,
            "drupal/core-project-message": true,
            "mglaman/composer-drupal-lenient": true,
            "oomphinc/composer-installers-extender": true,
            "php-http/discovery": true,
            "phpstan/extension-installer": true,
            "symfony/runtime": true,
            "tbachert/spi": true
        },
        "audit": {
            "abandoned": "ignore",
            "block-insecure": false,
            "ignore-severities": [
                "low",
                "medium",
                "high",
                "critical"
            ]
        }
    },
    "extra": {
        "drupal-lenient": {
            "allowed-list": [
                "drupal/address",
                "drupal/commerce",
                "drupal/ctools",
                "drupal/date_recur",
                "drupal/draggableviews",
                "drupal/dynamic_entity_reference",
                "drupal/eck",
                "drupal/entity",
                "drupal/entity_reference_revisions",
                "drupal/inline_entity_form",
                "drupal/mailsystem",
                "drupal/name",
                "drupal/paragraphs",
                "drupal/pathauto",
                "drupal/profile",
                "drupal/rat",
                "drupal/redirect",
                "drupal/scheduled_transitions",
                "drupal/search_api",
                "drupal/smart_date",
                "drupal/state_machine",
                "drupal/supported_image",
                "drupal/testmode",
                "drupal/text_with_summary",
                "drupal/time_field",
                "drupal/token",
                "drupal/webform"
            ]
        },
        "drupal-scaffold": {
            "locations": {
                "web-root": "./web"
            }
        },
        "enable-patching": true,
        "patches": {
            "drupal/ctools": {
                "Drupal 12: discover Relationship plugins by attribute": "patches/ctools-drupal12-attribute-discovery.patch"
            },
            "drupal/date_recur": {
                "Symfony 8: match the constraint validator signatures": "patches/date_recur-symfony8-validator-signatures.patch"
            },
            "drupal/dynamic_entity_reference": {
                "Drupal 12: declare the array return on massageFormValues()": "patches/dynamic_entity_reference-drupal12-massage-form-values.patch"
            },
            "drupal/eck": {
                "Drupal 12: match the getDefaultOperations() signature": "patches/eck-drupal12-default-operations.patch",
                "Drupal 12: register the entity preprocess function": "patches/eck-drupal12-preprocess-registration.patch"
            },
            "drupal/entity_reference_revisions": {
                "Drupal 12: declare the array return on massageFormValues()": "patches/entity_reference_revisions-drupal12-massage-form-values.patch"
            },
            "drupal/paragraphs": {
                "Drupal 12: declare the array return on massageFormValues()": "patches/paragraphs-drupal12-massage-form-values.patch"
            },
            "drupal/pathauto": {
                "Drupal 12: match the getDefaultOperations() signature": "patches/pathauto-drupal12-default-operations.patch"
            },
            "drupal/profile": {
                "Drupal 12: match the getDefaultOperations() signature": "patches/profile-drupal12-default-operations.patch"
            },
            "drupal/redirect": {
                "Symfony 8: match the constraint validator signatures": "patches/redirect-symfony8-validator-signatures.patch",
                "Drupal 12: declare the array return on massageFormValues()": "patches/redirect-drupal12-massage-form-values.patch",
                "Drupal 12: read the original entity through getOriginal()": "patches/redirect-drupal12-get-original.patch"
            },
            "drupal/scheduled_transitions": {
                "Drupal 12: match the getDefaultOperations() signature": "patches/scheduled-transitions-drupal12-default-operations.patch"
            },
            "drupal/state_machine": {
                "Symfony 8: match the constraint validator signatures": "patches/state_machine-symfony8-validator-signatures.patch"
            },
            "drupal/time_field": {
                "Symfony 8: match the constraint validator signatures": "patches/time_field-symfony8-validator-signatures.patch"
            },
            "drupal/webform": {
                "Drupal 12: match the getGroupedDefinitions() signature": "patches/webform-drupal12-grouped-definitions.patch",
                "Drupal 12: drop the removed archiver manager dependency": "patches/webform-drupal12-archiver-manager.patch",
                "Drupal 12: discover plugins by attribute": "patches/webform-drupal12-attribute-discovery.patch",
                "Drupal 12: match the getDefaultOperations() signature": "patches/webform-drupal12-default-operations.patch",
                "Drupal 12: declare the array return on massageFormValues()": "patches/webform-drupal12-massage-form-values.patch",
                "Symfony 8: read query parameters through the query bag": "patches/webform-symfony8-request-get.patch",
                "Drupal 12: read the original entity through getOriginal()": "patches/webform-drupal12-get-original.patch"
            }
        },
        "installer-paths": {
            "web/core": [
                "type:drupal-core"
            ],
            "web/libraries/{$name}": [
                "type:drupal-library",
                "type:bower-asset",
                "type:npm-asset"
            ],
            "web/modules/contrib/{$name}": [
                "type:drupal-module"
            ],
            "web/profiles/contrib/{$name}": [
                "type:drupal-profile"
            ],
            "web/themes/contrib/{$name}": [
                "type:drupal-theme"
            ],
            "drush/Commands/contrib/{$name}": [
                "type:drupal-drush"
            ]
        },
        "installer-types": [
            "bower-asset",
            "npm-asset"
        ]
    },
    "scripts": {
        "post-install-cmd": [
            "DrupalComposer\\DrupalScaffold\\Plugin::scaffold",
            "DrupalProject\\composer\\ScriptHandler::createRequiredFiles"
        ],
        "drupal-post-install": [
            "drush -r web config-set system.site uuid 5b4646a8-ed7b-453c-b5b6-78196271f41b -y --uri=http://nginx",
            "drush -r web updb -y --uri=http://nginx",
            "drush -r web cim --source=../config/sync -y --uri=http://nginx",
            "drush -r web cr -y --uri=http://nginx",
            "drush -r web pm:enable mysite_core -y --uri=http://nginx"
        ]
    }
}
