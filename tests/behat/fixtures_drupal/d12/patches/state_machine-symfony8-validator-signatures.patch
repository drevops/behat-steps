Match the Symfony 8 signatures on ConstraintValidatorInterface.

Symfony 8 declares 'mixed $value' and a void return on validate(), and a void
return on initialize(). These validators declare neither, so PHP rejects the
overrides while the module installs.

diff --git a/src/Plugin/Validation/Constraint/StateConstraintValidator.php b/src/Plugin/Validation/Constraint/StateConstraintValidator.php
--- a/src/Plugin/Validation/Constraint/StateConstraintValidator.php
+++ b/src/Plugin/Validation/Constraint/StateConstraintValidator.php
@@ -15,7 +15,7 @@
   /**
    * {@inheritdoc}
    */
-  public function validate($value, Constraint $constraint) {
+  public function validate(mixed $value, Constraint $constraint): void {
     if (!$value->isValid()) {
       $this->context->addViolation($constraint->message, ['@state' => $value->value]);
     }
