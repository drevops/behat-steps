Declare the cacheability argument Drupal 12 passes.

EntityListBuilder::getDefaultOperations() takes a CacheableMetadata argument.
The module already reads it through func_get_arg() and hands it to the parent,
but leaves the parameter commented out, so PHP rejects the override.

diff --git a/modules/promotion/src/PromotionListBuilder.php b/modules/promotion/src/PromotionListBuilder.php
--- a/modules/promotion/src/PromotionListBuilder.php
+++ b/modules/promotion/src/PromotionListBuilder.php
@@ -237,7 +237,7 @@
   /**
    * {@inheritdoc}
    */
-  protected function getDefaultOperations(EntityInterface $entity/* , ?CacheableMetadata $cacheability = NULL */) {
+  protected function getDefaultOperations(EntityInterface $entity, ?CacheableMetadata $cacheability = NULL) {
     $cacheability = func_num_args() > 1 ? func_get_arg(1) : NULL;
     $operations = parent::getDefaultOperations($entity, $cacheability);

