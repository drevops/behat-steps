Drop the archiver manager the exporter never uses.

Drupal 12 removed the Archiver plugin system, so the 'plugin.manager.archiver'
service no longer exists and the container refuses to build
'webform_submission.exporter'. WebformSubmissionExporter injects the manager
and assigns it, but calls nothing on it, so removing the dependency changes
no behaviour.

diff --git a/webform.services.yml b/webform.services.yml
--- a/webform.services.yml
+++ b/webform.services.yml
@@ -86,7 +86,7 @@

   webform_submission.exporter:
     class: Drupal\webform\WebformSubmissionExporter
-    arguments: ['@config.factory', '@file_system', '@entity_type.manager', '@stream_wrapper_manager', '@plugin.manager.archiver', '@plugin.manager.webform.element', '@plugin.manager.webform.exporter', '@language_manager']
+    arguments: ['@config.factory', '@file_system', '@entity_type.manager', '@stream_wrapper_manager', '@plugin.manager.webform.element', '@plugin.manager.webform.exporter', '@language_manager']

   webform.third_party_settings_manager:
     class: Drupal\webform\WebformThirdPartySettingsManager
