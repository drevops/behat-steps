# To ignore OS temporary files use global .gitignore
# https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files#configuring-ignored-files-for-all-repositories-on-your-computer

/.logs
/.phpunit.cache
/build
/composer.lock
/patches.lock.json
/docker-compose.override.yml
/vendor

# Temporary AI agent and developer artifacts (plans, scratch output, reports).
/.artifacts/

# A global gitignore commonly excludes .claude entirely. The project commits
# its own agent skills, so re-include that directory while leaving the rest of
# .claude - editor state and per-developer settings - untracked.
!/.claude/
/.claude/*
!/.claude/skills/

# Claude Code fetches the project update skill on demand; do not commit it.
/.claude/skills/update-consumer-scaffold/
