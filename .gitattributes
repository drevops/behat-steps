# Ignore files for distribution archives.
/.ahoy.yml           export-ignore
/.claude             export-ignore
/.docker             export-ignore
/.dockerignore       export-ignore
/.editorconfig       export-ignore
/.env                export-ignore
/.gitattributes      export-ignore
/.github             export-ignore
/.gitignore          export-ignore
/CLAUDE.md            export-ignore
/CONTRIBUTING.md     export-ignore
/behat.dist.php      export-ignore
/behat.php           export-ignore
/docker-compose.yml  export-ignore
# The step and helper references ship, so a consuming project's AI agent can
# read them from vendor/. 'git archive' skips everything below an ignored
# directory, so no directory above them is ignored.
/docs/*                  export-ignore
/docs/content            -export-ignore
/docs/content/*          export-ignore
/docs/content/helpers.md -export-ignore
/docs/content/steps.md   -export-ignore
/docs.php            export-ignore
/gherkinlint.json    export-ignore
/logo.png            export-ignore
/phpcs.xml           export-ignore
/phpstan.neon        export-ignore
/phpunit.xml         export-ignore
/rector.php          export-ignore
/renovate.json       export-ignore
/scripts             export-ignore
/tests               export-ignore
